{
  "$schema": "https://opencode.ai/config.json",
  // "plugin": ["opencode-openai-codex-auth"],
  // "enterprise": {
  //   "url": "https://enterprise.dev.opencode.ai",
  // },
  "instructions": ["STYLE_GUIDE.md"],
  "provider": {
    "opencode": {
      "options": {},
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer YOUR_GITHUB_PAT"
      },
      "enabled": false
    },
    "bio-blast": {
      "type": "local",
      "command": ["script/mcp/bio-blast"],
      "environment": {
        "BIO_MCP_BLAST_DIR": "/path/to/bio-mcp-blast",
        "PYTHONUNBUFFERED": "1"
      },
      "enabled": false
    },
    "bio-bwa": {
      "type": "local",
      "command": ["script/mcp/bio-bwa"],
      "environment": {
        "BIO_MCP_BWA_DIR": "/path/to/bio-mcp-bwa",
        "PYTHONUNBUFFERED": "1"
      },
      "enabled": false
    },
    "uniprot": {
      "type": "local",
      "command": ["uniprot-mcp"],
      "enabled": false
    },
    "tooluniverse": {
      "type": "local",
      "command": ["tooluniverse-mcp"],
      "enabled": false
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
  "keybinds": {
    "voice_record": "alt+v",
    "voice_talkback_toggle": "alt+shift+v",
    "voice_autosend_toggle": "alt+a",
    "voice_talkback_stop": "alt+s",
    "voice_profile_cycle": "alt+p"
  }
}
